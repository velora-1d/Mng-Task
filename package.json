{
	"name": "mng-task",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "node --env-file=.env ./node_modules/.bin/vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file=.env --import tsx src/lib/server/db/migrate.ts",
		"db:seed": "node --env-file=.env --import tsx src/lib/server/db/seed.ts",
		"db:reset": "npm run db:migrate && npm run db:seed"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1161.0",
		"@neon/auth": "^0.8.2",
		"@neon/config": "^1.10.0",
		"@neon/env": "^1.6.8",
		"@neon/realtime": "^0.1.2",
		"@neon/realtime-drizzle": "^0.1.0",
		"@neondatabase/serverless": "^1.2.0",
		"@node-rs/argon2": "^2.2.2",
		"@node-rs/argon2-wasm32-wasi": "^2.2.2",
		"drizzle-orm": "^0.45.4",
		"zod": "^4.6.7"
	}
}
